include LICENSE.txt
recursive-include qiskit/qasm/libs *.inc
include qiskit/visualization/circuit/styles/*.json
include qiskit/visualization/dag/styles/*.json

# Include the tests files.
recursive-include test *.py
include test/python/qasm/*.qasm
include test/python/visualization/references/*.png

include Cargo.toml
include Cargo.lock
# The Cargo configuration holds the build flags for the C dependencies, so it must be present when
# building from the sdist.
include .cargo/config.toml
recursive-include crates *
